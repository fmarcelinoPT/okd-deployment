global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode tcp
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend okd_api
    bind *:6443
    default_backend okd_api_backend

backend okd_api_backend
    balance roundrobin
    option tcp-check
    server bootstrap okd-bootstrap.{{ okd_base_domain }}:6443 check
    server master1 okd-master1.{{ okd_base_domain }}:6443 check
    server master2 okd-master2.{{ okd_base_domain }}:6443 check
    server master3 okd-master3.{{ okd_base_domain }}:6443 check

frontend okd_apps_http
    bind *:80
    default_backend okd_apps_http_backend

backend okd_apps_http_backend
    balance roundrobin
    server worker1 okd-worker1.{{ okd_base_domain }}:80 check
    server worker2 okd-worker2.{{ okd_base_domain }}:80 check
    server worker3 okd-worker3.{{ okd_base_domain }}:80 check
    server worker4 okd-worker4.{{ okd_base_domain }}:80 check
    server worker5 okd-worker5.{{ okd_base_domain }}:80 check
    server worker6 okd-worker6.{{ okd_base_domain }}:80 check
    server worker7 okd-worker7.{{ okd_base_domain }}:80 check
    server worker8 okd-worker8.{{ okd_base_domain }}:80 check
    server worker9 okd-worker9.{{ okd_base_domain }}:80 check

frontend okd_apps_https
    bind *:443
    default_backend okd_apps_https_backend

backend okd_apps_https_backend
    balance roundrobin
    server worker1 okd-worker1.{{ okd_base_domain }}:443 check
    server worker2 okd-worker2.{{ okd_base_domain }}:443 check
    server worker3 okd-worker3.{{ okd_base_domain }}:443 check
    server worker4 okd-worker4.{{ okd_base_domain }}:443 check
    server worker5 okd-worker5.{{ okd_base_domain }}:443 check
    server worker6 okd-worker6.{{ okd_base_domain }}:443 check
    server worker7 okd-worker7.{{ okd_base_domain }}:443 check
    server worker8 okd-worker8.{{ okd_base_domain }}:443 check
    server worker9 okd-worker9.{{ okd_base_domain }}:443 check
