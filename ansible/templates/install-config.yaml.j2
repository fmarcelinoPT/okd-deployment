apiVersion: v1
baseDomain: {{ okd_base_domain }}
compute:
- hyperthreading: Enabled
  name: worker
  replicas: {{ okd_worker_count }}
controlPlane:
  hyperthreading: Enabled
  name: master
  replicas: {{ okd_master_count }}
metadata:
  name: {{ okd_cluster_name }}
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  networkType: OpenShiftSDN
  serviceNetwork:
  - 172.30.0.0/16
platform:
  none: {}
pullSecret: '{{ okd_pull_secret }}'
sshKey: '{{ okd_ssh_key }}'